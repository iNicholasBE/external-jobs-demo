# Copy to .env and fill in your values. The .env file is gitignored.
# spring-dotenv loads this automatically when the app starts.

# --- Replicate (GPU video demo) ---
REPLICATE_API_TOKEN=r8_your_token_here

# --- Gemini (async webhooks demo) ---
# 1. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# 2. Expose this app publicly (e.g. ngrok http 8080) and paste the https URL here.
#    The app will register a webhook at <GEMINI_PUBLIC_URL>/gemini/webhook on startup.
GEMINI_PUBLIC_URL=https://your-tunnel.ngrok-free.app
